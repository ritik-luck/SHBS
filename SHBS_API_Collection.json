{
  "info": {
    "name": "SHBS (Self-Healing Business Service) API",
    "description": "API collection for testing SHBS endpoints, injecting chaos, managing incidents, and checking metrics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Admin Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/admin/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["admin", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Orders (Public)",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "uuid-1234-abcd" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product\": \"PROD-101\",\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/orders",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "Get Recent Orders",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/api/orders",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "orders"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin Operations",
      "item": [
        {
          "name": "Get Circuit Breaker Status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "http://localhost:8080/admin/circuit-breaker/status?serviceName=inventory-service",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["admin", "circuit-breaker", "status"],
              "query": [
                { "key": "serviceName", "value": "inventory-service" }
              ]
            }
          }
        },
        {
          "name": "Inject Chaos",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "http://localhost:8080/admin/chaos/inject?failRate=0.5&latencyMs=1000",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["admin", "chaos", "inject"],
              "query": [
                { "key": "failRate", "value": "0.5" },
                { "key": "latencyMs", "value": "1000" }
              ]
            }
          }
        },
        {
          "name": "Get Incidents",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "http://localhost:8080/admin/incidents",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["admin", "incidents"]
            }
          }
        }
      ]
    },
    {
      "name": "Observability (Actuator)",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/actuator/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["actuator", "health"]
            }
          }
        },
        {
          "name": "Prometheus Metrics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/actuator/prometheus",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["actuator", "prometheus"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "admin_token",
      "value": "PASTE_TOKEN_HERE"
    }
  ]
}
