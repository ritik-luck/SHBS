{
  "annotations": { "list": [] },
  "editable": true,
  "title": "SHBS — Self-Healing Backend System",
  "uid": "shbs-main",
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "rate(http_server_requests_seconds_count{application=\"shbs\"}[1m])", "legendFormat": "{{method}} {{uri}} {{status}}" }]
    },
    {
      "id": 2,
      "title": "HTTP Response Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{application=\"shbs\"}[1m]))", "legendFormat": "p95 {{uri}}" }]
    },
    {
      "id": 3,
      "title": "JVM Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "jvm_memory_used_bytes{application=\"shbs\",area=\"heap\"}", "legendFormat": "Heap Used" },
        { "expr": "jvm_memory_max_bytes{application=\"shbs\",area=\"heap\"}", "legendFormat": "Heap Max" }
      ]
    },
    {
      "id": 4,
      "title": "HikariCP Active DB Connections",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "targets": [{ "expr": "hikaricp_connections_active{application=\"shbs\"}", "legendFormat": "Active" }]
    },
    {
      "id": 5,
      "title": "Resilience4j Rate Limiter — Available Permissions",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "targets": [{ "expr": "resilience4j_ratelimiter_available_permissions{application=\"shbs\"}", "legendFormat": "{{name}}" }]
    },
    {
      "id": 6,
      "title": "Error Rate (5xx responses/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [{ "expr": "rate(http_server_requests_seconds_count{application=\"shbs\",status=~\"5..\"}[1m])", "legendFormat": "{{uri}} 5xx" }]
    },
    {
      "id": 7,
      "title": "JVM Threads",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "jvm_threads_live_threads{application=\"shbs\"}", "legendFormat": "Live Threads" },
        { "expr": "jvm_threads_peak_threads{application=\"shbs\"}", "legendFormat": "Peak Threads" }
      ]
    }
  ],
  "templating": { "list": [] },
  "schemaVersion": 39
}
